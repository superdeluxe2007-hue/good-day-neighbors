---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Newsletter from "../components/Newsletter.astro";
import UpcomingEvents from "../components/UpcomingEvents.astro";
import Supporters from "../components/Supporters.astro";
import ParkGallery from "../components/ParkGallery.astro";
import Icon from "../components/Icon.astro";
import penguin from "../assets/penguin.png";
import {
  SITE,
  categories,
  featuredPost,
  sortedPosts,

} from "../lib/blog-data.js";
import { graph, organizationSchema, webSiteSchema } from "../lib/structured-data.js";

// ヒーローの「直近のイベントを見る」リンク先に使う。
const featured = await featuredPost();
const latest = await sortedPosts();
const jsonLd = graph(organizationSchema(), webSiteSchema());
---

<BaseLayout
  title={`${SITE.name} - ご近所と、いい一日を。`}
  description={SITE.description}
  canonical="/"
  jsonLd={jsonLd}
  flushFooter
>
  <section class="relative -mt-[calc(4rem+2px)] overflow-hidden border-b border-border/60 pt-[calc(4rem+2px)]">
    <div class="mx-auto flex max-w-6xl flex-col items-center px-5 pb-16 pt-12 text-center sm:pb-20 sm:pt-16">
      <h1 class="font-serif text-[2.5rem] font-medium leading-[1.05] sm:text-6xl lg:text-7xl">
        Good Day Neighbors
      </h1>
      <Image
        src={penguin}
        alt="両手を広げたペンギンのイラスト。"
        class="flat-illustration mt-10 w-full max-w-[300px] sm:max-w-[380px]"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width={760}
        widths={[380, 560, 760]}
        sizes="(min-width: 640px) 380px, min(300px, 80vw)"
        format="webp"
        quality={88}
      />
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
        <a
          href={`/blog/${featured.slug}`}
          class="group inline-flex items-center gap-2 border-b border-foreground pb-1 text-sm font-medium text-foreground hover:border-foreground/60 hover:text-foreground/75"
        >
          直近のイベントを見る
          <Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
        </a>
        <a href="/blog" class="text-sm text-muted-foreground hover:text-foreground">
          イベント一覧を見る
        </a>
      </div>
    </div>
  </section>

  <UpcomingEvents />

  <section class="border-b border-border/60 bg-popover">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="font-serif text-2xl font-semibold">拠点</h2>
      <div class="mt-3 max-w-2xl">
        <h3 class="font-serif text-xl font-semibold">福山中央公園</h3>
        <p class="mt-3 leading-relaxed text-muted-foreground">
          福山駅から歩いて行ける、まちなかの芝生広場。PARK PIZZA PARTY やエディブルパーク、クリスマスマーケットなど、私たちの企画はここで開いています。大型テントを立てれば数百人が集まる場所になり、普段は誰でも自由に過ごせる公園です。
        </p>
      </div>
      <ParkGallery />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16" data-home-latest>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h2 class="font-serif text-2xl font-semibold">最新のイベント・お知らせ</h2>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          data-home-filter=""
          class="rounded-full border px-3 py-1 text-xs transition-colors border-foreground bg-foreground text-background"
        >
          すべて
        </button>
        {
          categories.map((category) => (
            <button
              type="button"
              data-home-filter={category.slug}
              class="rounded-full border px-3 py-1 text-xs transition-colors border-border text-muted-foreground hover:text-foreground"
            >
              {category.name}
            </button>
          ))
        }
      </div>
    </div>

    <div data-home-empty class="mt-12 rounded-md border border-dashed border-border py-16 text-center text-muted-foreground" hidden>
      このカテゴリーにはまだ投稿がありません。
    </div>

    <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {latest.map((post, index) => <PostCard post={post} hidden={index >= 6} />)}
    </div>

    <div class="mt-12 text-center">
      <a href="/blog" class="inline-flex items-center gap-2 rounded-md border border-border px-5 py-2.5 text-sm font-medium hover:bg-muted">
        イベント一覧を見る <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </div>
  </section>

  <Supporters />
  <Newsletter />
</BaseLayout>

<script>
  const latest = document.querySelector("[data-home-latest]");
  if (latest) {
    const buttons = [...latest.querySelectorAll("[data-home-filter]")];
    const cards = [...latest.querySelectorAll("[data-post-card]")];
    const empty = latest.querySelector("[data-home-empty]");
    const activeClasses = ["border-foreground", "bg-foreground", "text-background"];
    const inactiveClasses = ["border-border", "text-muted-foreground", "hover:text-foreground"];

    const setActive = (button, active) => {
      button.classList.toggle(activeClasses[0], active);
      button.classList.toggle(activeClasses[1], active);
      button.classList.toggle(activeClasses[2], active);
      inactiveClasses.forEach((className) => button.classList.toggle(className, !active));
    };

    const filterCards = (category) => {
      let visible = 0;
      cards.forEach((card) => {
        const match = !category || card.dataset.category === category;
        const show = match && visible < 6;
        card.hidden = !show;
        if (match) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
      buttons.forEach((button) => setActive(button, button.dataset.homeFilter === category));
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => filterCards(button.dataset.homeFilter || ""));
    });
  }
</script>
