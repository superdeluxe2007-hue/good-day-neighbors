---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Newsletter from "../components/Newsletter.astro";
import HowToJoin from "../components/HowToJoin.astro";
import UpcomingEvents from "../components/UpcomingEvents.astro";
import Supporters from "../components/Supporters.astro";
import Icon from "../components/Icon.astro";
import enleeInterior from "../assets/locations/enlee.jpg";
import parkScene from "../assets/locations/park.jpg";
import penguin from "../assets/penguin.png";
import {
  SITE,
  categories,
  featuredPost,
  sortedPosts,

  getCategory,
  formatDate,
} from "../lib/blog-data.js";
import { graph, organizationSchema, webSiteSchema } from "../lib/structured-data.js";

const featured = await featuredPost();
const featuredCategory = getCategory(featured.category);
const latest = (await sortedPosts()).filter((post) => post.slug !== featured.slug);
const jsonLd = graph(organizationSchema(), webSiteSchema());
---

<BaseLayout
  title={`${SITE.name} - ご近所と、いい一日を。`}
  description={SITE.description}
  canonical="/"
  jsonLd={jsonLd}
  flushFooter
>
  <section class="relative -mt-[calc(4rem+2px)] overflow-hidden border-b border-border/60 pt-[calc(4rem+2px)]">
    <div class="mx-auto flex max-w-6xl flex-col items-center px-5 pb-16 pt-12 text-center sm:pb-20 sm:pt-16">
      <h1 class="font-serif text-[2.5rem] font-medium leading-[1.05] sm:text-6xl lg:text-7xl">
        Good Day Neighbors
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
        福山市・中央公園を拠点に、学びと憩いの公園を目指す地域コミュニティ団体です。
      </p>
      <Image
        src={penguin}
        alt="両手を広げたペンギンのイラスト。"
        class="flat-illustration mt-10 w-full max-w-[300px] sm:max-w-[380px]"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width={760}
        widths={[380, 560, 760]}
        sizes="(min-width: 640px) 380px, min(300px, 80vw)"
        format="webp"
        quality={88}
      />
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
        <a
          href={`/blog/${featured.slug}`}
          class="group inline-flex items-center gap-2 border-b border-foreground pb-1 text-sm font-medium text-foreground hover:border-foreground/60 hover:text-foreground/75"
        >
          直近のイベントを見る
          <Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
        </a>
        <a href="/blog" class="text-sm text-muted-foreground hover:text-foreground">
          イベント一覧を見る
        </a>
      </div>
    </div>
  </section>

  <section class="border-b border-border/60 bg-popover">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <div class="mb-6 flex items-center justify-between">
        <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">注目</div>
        <a href="/blog" class="text-xs text-muted-foreground hover:text-foreground">すべて見る &rarr;</a>
      </div>
      <article class="grid gap-10 lg:grid-cols-2">
        <a href={`/blog/${featured.slug}`} class="group block" aria-label={`${featured.title}を読む`}>
          <div class="aspect-[4/3] overflow-hidden rounded-md bg-muted">
            {
              featured.thumbnail && (
                <Image
                  src={featured.thumbnail}
                  alt={featured.thumbnailAlt}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                  width={720}
                  widths={[372, 560, 720]}
                  sizes="(min-width: 1024px) 560px, calc(100vw - 40px)"
                  format="webp"
                  quality={64}
                />
              )
            }
          </div>
        </a>
        <div class="flex flex-col justify-center">
          <div class="flex items-center gap-3 text-xs uppercase tracking-wider text-muted-foreground">
            {
              featuredCategory && (
                <a href={`/categories/${featuredCategory.slug}`} class="inline-flex min-h-9 items-center text-primary hover:underline">
                  {featuredCategory.name}
                </a>
              )
            }
            <span>&middot;</span>
            <time datetime={featured.date}>{formatDate(featured.date)}</time>
          </div>
          <a href={`/blog/${featured.slug}`} class="mt-2 block py-1">
            <h2 class="font-serif text-3xl font-semibold leading-tight hover:text-primary sm:text-4xl">
              {featured.title}
            </h2>
          </a>
          <p class="mt-4 text-lg text-muted-foreground">{featured.excerpt}</p>
          <div class="mt-6 flex items-center gap-3 text-sm text-muted-foreground">
            <span>主催: {featured.organizer}</span>
            <span>&middot;</span>
            <span>約{featured.readingTime}分で読めます</span>
          </div>
          <a href={`/blog/${featured.slug}`} class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline">
            詳しく見る <Icon name="arrow-right" class="h-3.5 w-3.5" />
          </a>
        </div>
      </article>
    </div>
  </section>

  <UpcomingEvents />

  <section class="border-b border-border/60 bg-popover">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="font-serif text-2xl font-semibold">拠点</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-3">
        <div>
          <div class="aspect-[4/3] overflow-hidden rounded-md bg-muted">
            <Image
              src={parkScene}
              alt="中央公園でのアウトドアイベントの様子"
              class="h-full w-full object-cover"
              width={400}
              widths={[280, 400]}
              sizes="(min-width: 640px) 30vw, 90vw"
              format="webp"
              quality={64}
            />
          </div>
          <h3 class="mt-3 font-serif text-lg font-semibold">中央公園</h3>
          <p class="mt-2 text-sm text-muted-foreground">福山市の中央公園。PPPやエディブルパークなど、体を動かす系・飲食/マルシェ系のイベントの舞台です。</p>
        </div>
        <div>
          <div class="aspect-[4/3] overflow-hidden rounded-md bg-muted">
            <Image
              src={enleeInterior}
              alt="Enlee店内の様子"
              class="h-full w-full object-cover"
              width={400}
              widths={[280, 400]}
              sizes="(min-width: 640px) 30vw, 90vw"
              format="webp"
              quality={64}
            />
          </div>
          <h3 class="mt-3 font-serif text-lg font-semibold">Enlee</h3>
          <p class="mt-2 text-sm text-muted-foreground">中央公園内のガーデンレストラン。PPPの会場、「クラス」の開催地として連携しています。</p>
        </div>
        <div>
          <div class="aspect-[4/3] overflow-hidden rounded-md bg-muted" />
          <h3 class="mt-3 font-serif text-lg font-semibold">KOKON</h3>
          <p class="mt-2 text-sm text-muted-foreground">屋内スペース（最大40名程度）。料理・スイーツ・フラワーなどの教室・セミナー系イベントに向いています。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16" data-home-latest>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h2 class="font-serif text-2xl font-semibold">最新のイベント・お知らせ</h2>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          data-home-filter=""
          class="rounded-full border px-3 py-1 text-xs transition-colors border-foreground bg-foreground text-background"
        >
          すべて
        </button>
        {
          categories.map((category) => (
            <button
              type="button"
              data-home-filter={category.slug}
              class="rounded-full border px-3 py-1 text-xs transition-colors border-border text-muted-foreground hover:text-foreground"
            >
              {category.name}
            </button>
          ))
        }
      </div>
    </div>

    <div data-home-empty class="mt-12 rounded-md border border-dashed border-border py-16 text-center text-muted-foreground" hidden>
      このカテゴリーにはまだ投稿がありません。
    </div>

    <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {latest.map((post, index) => <PostCard post={post} hidden={index >= 6} />)}
    </div>

    <div class="mt-12 text-center">
      <a href="/blog" class="inline-flex items-center gap-2 rounded-md border border-border px-5 py-2.5 text-sm font-medium hover:bg-muted">
        イベント一覧を見る <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </div>
  </section>

  <Supporters />
  <HowToJoin />
  <Newsletter />
</BaseLayout>

<script>
  const latest = document.querySelector("[data-home-latest]");
  if (latest) {
    const buttons = [...latest.querySelectorAll("[data-home-filter]")];
    const cards = [...latest.querySelectorAll("[data-post-card]")];
    const empty = latest.querySelector("[data-home-empty]");
    const activeClasses = ["border-foreground", "bg-foreground", "text-background"];
    const inactiveClasses = ["border-border", "text-muted-foreground", "hover:text-foreground"];

    const setActive = (button, active) => {
      button.classList.toggle(activeClasses[0], active);
      button.classList.toggle(activeClasses[1], active);
      button.classList.toggle(activeClasses[2], active);
      inactiveClasses.forEach((className) => button.classList.toggle(className, !active));
    };

    const filterCards = (category) => {
      let visible = 0;
      cards.forEach((card) => {
        const match = !category || card.dataset.category === category;
        const show = match && visible < 6;
        card.hidden = !show;
        if (match) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
      buttons.forEach((button) => setActive(button, button.dataset.homeFilter === category));
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => filterCards(button.dataset.homeFilter || ""));
    });
  }
</script>
