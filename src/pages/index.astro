---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Newsletter from "../components/Newsletter.astro";
import UpcomingEvents from "../components/UpcomingEvents.astro";
import Supporters from "../components/Supporters.astro";
import ParkGallery from "../components/ParkGallery.astro";
import Icon from "../components/Icon.astro";
// クリスマスマーケットの会期までの期間限定。終わったら penguin.png に戻す。
// 動画とポスターは public/hero/ に置いている（Astro の画像処理を通さない）。
const heroAlt =
  "Christmas Market in FUKUYAMA の告知ビジュアル。手描きの鹿のイラストと「クリスマスの余韻を公園で」の文字、12月25日から27日・16時から21時・福山中央公園・入場無料の案内。";
import {
  SITE,
  announcementCategories,
  featuredPost,
  announcementPosts,

} from "../lib/blog-data.js";
import { graph, organizationSchema, webSiteSchema } from "../lib/structured-data.js";

// ヒーローの「直近のイベントを見る」リンク先に使う。
const featured = await featuredPost();
// 開催レポートは /join に集約しているため、ここには出さない。
const latest = await announcementPosts();
const jsonLd = graph(organizationSchema(), webSiteSchema());
---

<BaseLayout
  title={`${SITE.name} - ご近所と、いい一日を。`}
  description={SITE.description}
  canonical="/"
  jsonLd={jsonLd}
  flushFooter
>
  <section class="relative -mt-[calc(4rem+2px)] overflow-hidden border-b border-border/60 pt-[calc(4rem+2px)]">
    <div class="mx-auto flex max-w-6xl flex-col items-center px-5 pb-16 pt-12 text-center sm:pb-20 sm:pt-16">
      <h1 class="font-serif text-[2.5rem] font-medium leading-[1.05] sm:text-6xl lg:text-7xl">
        Good Day Neighbors
      </h1>
      <div
        class="mt-10 w-full max-w-[340px] rounded-[28px] bg-white p-5 shadow-[0_18px_50px_-20px_rgba(31,58,95,0.35)] sm:max-w-[420px]"
      >
        <video
          class="h-auto w-full motion-reduce:hidden"
          src="/hero/christmas-market.mp4"
          poster="/hero/christmas-market-poster.jpg"
          width="720"
          height="898"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-label={heroAlt}></video>
        <img
          src="/hero/christmas-market-poster.jpg"
          alt={heroAlt}
          class="hidden h-auto w-full motion-reduce:block"
          width="720"
          height="898"
          decoding="async"
        />
      </div>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
        <a
          href={`/blog/${featured.slug}`}
          class="group inline-flex items-center gap-2 border-b border-foreground pb-1 text-sm font-medium text-foreground hover:border-foreground/60 hover:text-foreground/75"
        >
          直近のイベントを見る
          <Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
        </a>
        <a href="/blog" class="text-sm text-muted-foreground hover:text-foreground">
          イベント一覧を見る
        </a>
      </div>
    </div>
  </section>

  <UpcomingEvents />

  <!--
    冬の夜の公園（映像: ジュンゾウさん @junzone・掲載許可済み 2026-11-13）。
    536×954 の縦動画なので横いっぱいには広げない。ページ下にあるため、見える位置に来てから読み込む。
  -->
  <section class="bg-foreground text-background" aria-labelledby="night-park-heading">
    <div
      class="mx-auto grid max-w-6xl gap-8 px-5 py-16 text-center sm:py-20 lg:grid-cols-[auto_1fr] lg:grid-rows-[1fr_1fr] lg:gap-x-16 lg:gap-y-0 lg:text-left"
    >
      <div class="lg:col-start-2 lg:self-end">
        <p class="text-sm font-medium tracking-[0.2em] text-background/60">冬の夜の公園</p>
        <h2 id="night-park-heading" class="mt-3 font-serif text-3xl font-semibold leading-[1.3] sm:text-4xl">
          灯りと焚き火で、<br />夜の公園に人が集まる。
        </h2>
      </div>
      <figure class="mx-auto w-full max-w-[300px] sm:max-w-[340px] lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:max-w-[360px]">
        <div class="overflow-hidden rounded-[28px] bg-black/40 shadow-[0_24px_60px_-24px_rgba(0,0,0,0.8)]">
          <video
            class="block aspect-[536/954] h-auto w-full object-cover motion-reduce:hidden"
            data-src="/hero/night-park.mp4"
            data-lazy-video
            poster="/hero/night-park-poster.jpg"
            width="536"
            height="954"
            muted
            loop
            playsinline
            preload="none"
            aria-label="夜の公園の映像。電球の灯りの下で薪を割り、焚き火を囲んで、子どもや大人がホットドッグを食べたり写真を撮ったりしている。"
          ></video>
          <img
            src="/hero/night-park-poster.jpg"
            alt="焚き火の炎と薪。"
            class="hidden aspect-[536/954] h-auto w-full object-cover motion-reduce:block"
            width="536"
            height="954"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="mt-3 text-center text-xs text-background/60">
          映像：ジュンゾウ（<a
            href="https://www.instagram.com/junzone/"
            class="underline-offset-2 hover:text-background hover:underline"
            target="_blank"
            rel="noopener">@junzone</a
          >）
        </figcaption>
      </figure>
      <div class="lg:col-start-2 lg:row-start-2 lg:self-start">
        <p class="mx-auto max-w-md text-balance leading-relaxed text-background/75 lg:mx-0 lg:mt-5">
          日が落ちると暗くなる冬の中央公園も、電球の灯りと焚き火があれば、寒い夜にゆっくり過ごせる場所になります。12月のクリスマスマーケットでも、焚き火を囲める場所をつくります。
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-4 lg:justify-start">
          <a
            href="/blog/christmas-market-2026"
            class="group inline-flex items-center gap-2 border-b border-background pb-1 text-sm font-medium hover:border-background/60 hover:text-background/75"
          >
            クリスマスマーケットを見る
            <Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
          </a>
          <a href="/about#vision" class="text-sm text-background/60 hover:text-background">
            私たちが目指す公園のかたち
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-border/60 bg-popover">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="font-serif text-2xl font-semibold">拠点</h2>
      <div class="mt-3 max-w-2xl">
        <h3 class="font-serif text-xl font-semibold">福山中央公園</h3>
        <p class="mt-3 leading-relaxed text-muted-foreground">
          福山駅から歩いて行ける、まちなかの芝生広場。PARK PIZZA PARTY やクリスマスマーケットなど、私たちの企画はここで開いています。大型テントを立てれば数百人が集まる場所になり、普段は誰でも自由に過ごせる公園です。
        </p>
      </div>
      <ParkGallery />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16" data-home-latest>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h2 class="font-serif text-2xl font-semibold">最新のイベント・お知らせ</h2>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          data-home-filter=""
          class="rounded-full border px-3 py-1 text-xs transition-colors border-foreground bg-foreground text-background"
        >
          すべて
        </button>
        {
          announcementCategories.map((category) => (
            <button
              type="button"
              data-home-filter={category.slug}
              class="rounded-full border px-3 py-1 text-xs transition-colors border-border text-muted-foreground hover:text-foreground"
            >
              {category.name}
            </button>
          ))
        }
      </div>
    </div>

    <div data-home-empty class="mt-12 rounded-md border border-dashed border-border py-16 text-center text-muted-foreground" hidden>
      このカテゴリーにはまだ投稿がありません。
    </div>

    <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-10 lg:grid-cols-3">
      {latest.map((post, index) => <PostCard post={post} hidden={index >= 6} />)}
    </div>

    <div class="mt-12 text-center">
      <a href="/blog" class="inline-flex items-center gap-2 rounded-md border border-border px-5 py-2.5 text-sm font-medium hover:bg-muted">
        イベント一覧を見る <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </div>
  </section>

  <Supporters />
  <Newsletter />
</BaseLayout>

<script>
  const latest = document.querySelector("[data-home-latest]");
  if (latest) {
    const buttons = [...latest.querySelectorAll("[data-home-filter]")];
    const cards = [...latest.querySelectorAll("[data-post-card]")];
    const empty = latest.querySelector("[data-home-empty]");
    const activeClasses = ["border-foreground", "bg-foreground", "text-background"];
    const inactiveClasses = ["border-border", "text-muted-foreground", "hover:text-foreground"];

    const setActive = (button, active) => {
      button.classList.toggle(activeClasses[0], active);
      button.classList.toggle(activeClasses[1], active);
      button.classList.toggle(activeClasses[2], active);
      inactiveClasses.forEach((className) => button.classList.toggle(className, !active));
    };

    const filterCards = (category) => {
      let visible = 0;
      cards.forEach((card) => {
        const match = !category || card.dataset.category === category;
        const show = match && visible < 6;
        card.hidden = !show;
        if (match) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
      buttons.forEach((button) => setActive(button, button.dataset.homeFilter === category));
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => filterCards(button.dataset.homeFilter || ""));
    });
  }

  // 冬の夜の公園の動画: 画面に近づいてから読み込んで再生する（2.3MB を最初に読まないため）。
  const lazyVideos = document.querySelectorAll("video[data-lazy-video]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (lazyVideos.length && !reduceMotion) {
    const start = (video) => {
      if (!video.src) video.src = video.dataset.src;
      video.play().catch(() => {});
    };
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) start(entry.target);
            else if (entry.target.src) entry.target.pause();
          });
        },
        { rootMargin: "200px 0px" },
      );
      lazyVideos.forEach((video) => observer.observe(video));
    } else {
      lazyVideos.forEach(start);
    }
  }
</script>
