---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../lib/blog-data.js";
import { CONTACT } from "../config/theme.config.ts";
---

<BaseLayout
  title={`Contact - ${SITE.name}`}
  description={`${SITE.name} へのお問い合わせ・イベントのご予約はInstagramまたは公式LINEから。`}
  canonical="/contact"
>
  <div class="mx-auto max-w-2xl px-5 py-12">
    <Breadcrumbs items={[{ label: "トップ", to: "/" }, { label: "Contact" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Contact</div>
      <h1 class="mt-2 font-serif text-5xl font-semibold">お問い合わせ</h1>
      <p class="mt-4 max-w-xl text-muted-foreground">
        イベントのご予約・ご質問は、InstagramまたはGDN公式LINEからお願いします。
      </p>
    </header>

    <div class="mt-12 space-y-4">
      <a
        href={CONTACT.instagramUrl}
        target="_blank"
        rel="noreferrer"
        class="flex items-center gap-4 rounded-md border border-border p-5 transition-colors hover:border-primary hover:text-primary"
      >
        <Icon name="instagram" class="h-6 w-6" />
        <div>
          <div class="font-serif text-lg font-semibold">Instagram</div>
          <div class="text-sm text-muted-foreground">{CONTACT.instagramHandle} — イベント告知・予約導線はこちら</div>
        </div>
        <Icon name="arrow-right" class="ml-auto h-4 w-4" />
      </a>

      <a
        href={CONTACT.lineUrl}
        target="_blank"
        rel="noreferrer"
        class="flex items-center gap-4 rounded-md border border-border p-5 transition-colors hover:border-primary hover:text-primary"
      >
        <Icon name="line" class="h-6 w-6" />
        <div>
          <div class="font-serif text-lg font-semibold">GDN公式LINE</div>
          <div class="text-sm text-muted-foreground">イベントに関するご質問はこちらへ</div>
        </div>
        <Icon name="arrow-right" class="ml-auto h-4 w-4" />
      </a>

      <a
        href={`mailto:${CONTACT.email}`}
        class="flex items-center gap-4 rounded-md border border-border p-5 transition-colors hover:border-primary hover:text-primary"
      >
        <Icon name="mail" class="h-6 w-6" />
        <div>
          <div class="font-serif text-lg font-semibold">メール</div>
          <div class="text-sm text-muted-foreground">{CONTACT.email}</div>
        </div>
        <Icon name="arrow-right" class="ml-auto h-4 w-4" />
      </a>
    </div>

    <div class="mt-10 rounded-md border border-dashed border-border p-6">
      <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">場所貸しについて</div>
      <p class="mt-2 text-sm text-muted-foreground">
        中央公園・KOKONでのイベント開催にご興味のある方は、まずはInstagramまたは公式LINEよりご相談ください。GDNの理念に合うか、当日運営を自走できるかを踏まえてご案内します。
      </p>
    </div>
  </div>
</BaseLayout>
