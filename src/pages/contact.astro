---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../lib/blog-data.js";
import { CONTACT } from "../config/theme.config.ts";
---

<BaseLayout
  title={`Contact - ${SITE.name}`}
  description="Good Day Neighbors の最新情報はInstagramで発信しています。福山中央公園でのイベント出店・備品レンタルのお申し込みもこちらから。"
  canonical="/contact"
>
  <div class="mx-auto max-w-2xl px-5 py-12">
    <Breadcrumbs items={[{ label: "トップ", to: "/" }, { label: "Contact" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Contact</div>
      <h1 class="mt-2 font-serif text-5xl font-semibold">お問い合わせ</h1>
      <p class="mt-4 max-w-xl text-muted-foreground">
        イベントの最新情報はInstagramで発信しています。イベントは予約不要で、当日そのままお越しいただけます。出店・備品レンタルのお申し込みは申込フォームから承ります。
      </p>
    </header>

    <div class="mt-12 space-y-4">
      <a
        href={CONTACT.instagramUrl}
        target="_blank"
        rel="noreferrer"
        class="flex items-center gap-4 rounded-md border border-border p-5 transition-colors hover:border-primary hover:text-primary"
      >
        <Icon name="instagram" class="h-6 w-6" />
        <div>
          <div class="font-serif text-lg font-semibold">Instagram</div>
          <div class="text-sm text-muted-foreground">{CONTACT.instagramHandle} — イベントの告知・活動の様子はこちら</div>
        </div>
        <Icon name="arrow-right" class="ml-auto h-4 w-4" />
      </a>

      {
        CONTACT.applyFormUrl && (
          <a
            href={CONTACT.applyFormUrl}
            target="_blank"
            rel="noreferrer"
            class="flex items-center gap-4 rounded-md border border-border p-5 transition-colors hover:border-primary hover:text-primary"
          >
            <Icon name="check" class="h-6 w-6" />
            <div>
              <div class="font-serif text-lg font-semibold">出店・備品レンタルのお申し込み</div>
              <div class="text-sm text-muted-foreground">
                中央公園でのイベント出店をご希望の方はこちらから
              </div>
            </div>
            <Icon name="arrow-right" class="ml-auto h-4 w-4" />
          </a>
        )
      }
    </div>

    <div class="mt-10 rounded-md border border-dashed border-border p-6">
      <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">出店・場所のご利用について</div>
      <p class="mt-2 text-sm text-muted-foreground">
        福山中央公園でのイベント出店・備品レンタルについては、<a href="/join" class="text-foreground underline underline-offset-2 hover:text-primary">出店・ご利用について</a>のページに条件と料金を掲載しています。
      </p>
    </div>
  </div>
</BaseLayout>
