---
import Icon from "./Icon.astro";
import PostCard from "./PostCard.astro";
import Newsletter from "./Newsletter.astro";
import { SITE, categories, tags, popularPosts, sortedPosts } from "../lib/blog-data.js";

const recent = (await sortedPosts()).slice(0, 4);
const popular = await popularPosts();
---

<aside class="space-y-10">
  <div>
    <div class="text-sm font-medium">{SITE.name}</div>
    <p class="mt-3 text-sm text-muted-foreground">{SITE.description}</p>
  </div>

  <div>
    <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">カテゴリー</div>
    <ul class="mt-3 space-y-2 text-sm">
      {
        categories.map((category) => (
          <li>
            <a href={`/categories/${category.slug}`} class="text-foreground/80 hover:text-primary">
              {category.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div>
    <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">人気の投稿</div>
    <div class="mt-3 space-y-4">
      {popular.map((post) => <PostCard post={post} variant="compact" />)}
    </div>
  </div>

  <div>
    <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">最近の投稿</div>
    <div class="mt-3 space-y-4">
      {recent.map((post) => <PostCard post={post} variant="compact" />)}
    </div>
  </div>

  <div>
    <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">タグ</div>
    <div class="mt-3 flex flex-wrap gap-2">
      {
        tags.map((tag) => (
          <a
            href={`/tags/${tag.slug}`}
            class="rounded-full border border-border px-2.5 py-1 text-xs text-muted-foreground hover:border-primary hover:text-primary"
          >
            {tag.name}
          </a>
        ))
      }
    </div>
  </div>

  <Newsletter compact />

  <a href="/rss.xml" class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary">
    <Icon name="rss" class="h-3.5 w-3.5" /> RSSで購読
  </a>
</aside>
