---
import Icon from "./Icon.astro";
import { CONTACT } from "../config/theme.config.ts";

const { compact = false } = Astro.props;

const steps = [
  {
    icon: "instagram",
    title: "Instagramをフォロー",
    text: "最新のイベント告知や活動の様子はInstagramで発信しています。",
  },
  {
    icon: "line",
    title: "公式LINEで質問",
    text: "参加方法や持ち物など、気になることは公式LINEからお気軽に。",
  },
  {
    icon: "arrow-right",
    title: "当日、会場へ",
    text: "中央公園・Enlee・KOKONなど、イベントごとの会場にお越しください。",
  },
];
---

<section class:list={["border-t border-border/60", compact ? "py-12" : "py-16 bg-popover"]}>
  <div class="mx-auto max-w-6xl px-5">
    <h2 class="font-serif text-2xl font-semibold">参加方法</h2>
    <div class="mt-8 grid gap-8 sm:grid-cols-3">
      {
        steps.map((step, index) => (
          <div class="relative">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-foreground text-sm font-semibold text-background">
                {index + 1}
              </span>
              <Icon name={step.icon} class="h-5 w-5 text-primary" />
            </div>
            <h3 class="mt-3 font-serif text-lg font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{step.text}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={CONTACT.instagramUrl}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-2 rounded-md bg-foreground px-5 py-2.5 text-sm font-medium text-background hover:opacity-90"
      >
        <Icon name="instagram" class="h-4 w-4" /> Instagramをフォロー
      </a>
      <a
        href={CONTACT.lineUrl}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-2 rounded-md border border-border px-5 py-2.5 text-sm font-medium hover:border-primary hover:text-primary"
      >
        <Icon name="line" class="h-4 w-4" /> 公式LINEを追加
      </a>
    </div>
  </div>
</section>
