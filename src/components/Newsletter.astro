---
import Icon from "./Icon.astro";
import { CONTACT } from "../config/theme.config.ts";

const { compact = false } = Astro.props;
---

{
  compact ? (
    <div>
      <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">最新情報</div>
      <p class="mt-2 text-sm text-muted-foreground">イベントの告知はInstagramと公式LINEで配信しています。</p>
      <div class="mt-3 flex flex-col gap-2">
        <a
          href={CONTACT.instagramUrl}
          target="_blank"
          rel="noreferrer"
          class="flex items-center justify-center gap-2 rounded-md bg-foreground px-3 py-2 text-sm font-medium text-background transition-opacity hover:opacity-90"
        >
          <Icon name="instagram" class="h-4 w-4" /> Instagramをフォロー
        </a>
        <a
          href={CONTACT.lineUrl}
          target="_blank"
          rel="noreferrer"
          class="flex items-center justify-center gap-2 rounded-md border border-border px-3 py-2 text-sm font-medium transition-colors hover:border-primary hover:text-primary"
        >
          <Icon name="line" class="h-4 w-4" /> 公式LINEを追加
        </a>
      </div>
    </div>
  ) : (
    <section data-newsletter-cta class="border-t border-border/60 pt-16 pb-10">
      <div class="mx-auto max-w-2xl px-5 text-center">
        <h2 class="font-serif text-3xl font-semibold sm:text-4xl">最新のイベント情報を受け取る</h2>
        <p class="mt-3 text-muted-foreground">
          PPP・エディブルパーク・クラスなど、新しいイベントの告知はInstagramと公式LINEでお届けします。
        </p>
        <div class="mx-auto mt-6 flex max-w-md flex-col gap-3 sm:flex-row sm:justify-center">
          <a
            href={CONTACT.instagramUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-md bg-foreground px-5 py-3 text-sm font-medium text-background transition-opacity hover:opacity-90"
          >
            <Icon name="instagram" class="h-4 w-4" /> Instagramをフォロー
          </a>
          <a
            href={CONTACT.lineUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-md border border-border px-5 py-3 text-sm font-medium transition-colors hover:border-primary hover:text-primary"
          >
            <Icon name="line" class="h-4 w-4" /> 公式LINEを追加
          </a>
        </div>
      </div>
    </section>
  )
}
